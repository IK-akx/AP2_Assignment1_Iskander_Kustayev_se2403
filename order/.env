# Order Service
ORDER_SERVICE_PORT=8080
ORDER_GRPC_PORT=50052

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=0000
DB_NAME=order_db
DB_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=300

# Rate Limiter
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Payment Service
PAYMENT_GRPC_HOST=localhost
PAYMENT_GRPC_PORT=50051
PAYMENT_GRPC_TIMEOUT=3

# Gin Mode
GIN_MODE=debug