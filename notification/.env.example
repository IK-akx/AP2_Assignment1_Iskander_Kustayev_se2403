# NATS Configuration
NATS_URL=nats://localhost:4222

# Email Provider Configuration
PROVIDER_MODE=SIMULATED  # SIMULATED or REAL

# Simulated Provider Settings
SIMULATED_DELAY_MS=200
SIMULATED_FAILURE_RATE=0.3  # 30% failure rate for testing

# Real SMTP Provider Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Configuration
WORKER_COUNT=5              # Number of concurrent workers
MAX_RETRIES=3               # Max retry attempts (2s, 4s, 8s)
IDEMPOTENCY_TTL_HOURS=24    # How long to remember processed events

# Service Port
NOTIFICATION_PORT=8082